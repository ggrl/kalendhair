# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Every value below is a placeholder, not a working one. rules/secrets.md forbids a real
# password or connection string in a committed file, an example included, so this file
# describes the shape and nothing else. Choose your own local password: it protects a
# database of fake names on your own machine, and it is not shared with anybody.
#
# SINGLE-QUOTE ANY VALUE YOU CHOSE YOURSELF, like SALON_PASSWORD='meins$2026'.
# Two things read this file and they disagree about `$`: docker compose expands it, and
# `node --env-file` does not. Unquoted, `meins$2026` reaches the server as `meins` under
# compose and as `meins$2026` under npm start - and since the password is seeded into the
# database once and never again, the salon then cannot log in with the password it chose.
# Single quotes are the one form both read the same way. Do not write `$$`: compose reads
# that correctly and node hands you a literal `$$`.

# Used by docker-compose.yml. Compose refuses to start if it is not set.
POSTGRES_PASSWORD=

# The same password, inside the connection strings the application and tests use.
DATABASE_URL=postgres://salon:PASSWORD_FROM_ABOVE@127.0.0.1:5432/salon

# A separate database, because the test suite truncates tables. Keeping it apart from
# DATABASE_URL is what stops a test run emptying the data you were looking at.
TEST_DATABASE_URL=postgres://salon:PASSWORD_FROM_ABOVE@127.0.0.1:5432/salon_test

# ADR-0007: the salon's own timezone, explicit and never inferred. A container's clock is
# normally UTC, so guessing this makes the board a day out for part of every night.
SALON_TIMEZONE=Europe/Berlin

# Loopback, because running the server on the host has no TLS and nothing in front of it.
# IGNORED UNDER DOCKER COMPOSE, which overrides this to 0.0.0.0 - inside a container
# 127.0.0.1 would mean that container alone. Reach is limited there by compose publishing the
# port to 127.0.0.1 on the host instead.
HOST=127.0.0.1
PORT=3000

# Whether the session cookie is marked Secure, meaning the browser will only ever send it over
# HTTPS. Leave it unset and it follows HOST: loopback means no, anything else means yes.
#
# Which way the guess falls therefore depends on how you started the server, and the two cases
# are opposite:
#
#   npm start on the host, behind a TLS proxy -> HOST is loopback, the guess says NO, and the
#     session cookie travels in clear text on any plain-HTTP request to the same hostname.
#     SET THIS TO true. This is the case the setting exists for.
#   docker compose -> compose sets HOST to 0.0.0.0, so the guess already says yes and the
#     cookie is marked Secure whether or not this is set. Setting it anyway costs nothing and
#     stops that flipping silently if HOST ever moves back.
#
# The startup log says which way it went, every time.
# COOKIE_SECURE=true

# ADR-0017: three credentials with three jobs, and the server refuses to start without any of
# them. No values here, for the same reason POSTGRES_PASSWORD has none - rules/secrets.md
# forbids a real one in a tracked file, and a placeholder is the thing people forget to change.

# Signs the session cookie. At least 32 characters, and not a password anybody types:
# `openssl rand -base64 24` is the whole job. Changing it logs everybody out.
SESSION_SECRET=

# The way back in when the salon password and the PIN are both forgotten. It opens one screen -
# set a new password and a new PIN - and never sees a customer name. It cannot be changed from
# any screen, only here.
MASTER_PASSWORD=

# These two seed the database the first time the server starts and are IGNORED afterwards, so
# changing them here does not change the password: the settings screen and the master-password
# reset do. They stay required, so that no machine ever runs with only some of the three set.
# The password needs at least 8 characters and the PIN is exactly four digits.
SALON_PASSWORD=
SALON_PIN=
