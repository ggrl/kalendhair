# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Every value below is a placeholder, not a working one. rules/secrets.md forbids a real
# password or connection string in a committed file, an example included, so this file
# describes the shape and nothing else. Choose your own local password: it protects a
# database of fake names on your own machine, and it is not shared with anybody.

# Used by docker-compose.yml. Compose refuses to start if it is not set.
POSTGRES_PASSWORD=

# The same password, inside the connection strings the application and tests use.
DATABASE_URL=postgres://salon:PASSWORD_FROM_ABOVE@127.0.0.1:5432/salon

# A separate database, because the test suite truncates tables. Keeping it apart from
# DATABASE_URL is what stops a test run emptying the data you were looking at.
TEST_DATABASE_URL=postgres://salon:PASSWORD_FROM_ABOVE@127.0.0.1:5432/salon_test

# ADR-0007: the salon's own timezone, explicit and never inferred. A container's clock is
# normally UTC, so guessing this makes the board a day out for part of every night.
SALON_TIMEZONE=Europe/Berlin

# The server has no authentication yet - ADR-0004 is marked to be revisited before any is
# written - so it binds to loopback. Do not change this until that is settled.
HOST=127.0.0.1
PORT=3000
